# API
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200
PORTAL_RATE_LIMIT_PER_MINUTE=60
JWT_SECRET=erp360-dev-secret-change-me
# Temporarily enable only while provisioning NEW companies, then disable.
BOOTSTRAP_ENABLED=false
# Explicit development-only admin provisioning; never populate in production.
DEV_ADMIN_EMAIL=
DEV_ADMIN_FULL_NAME=
DEV_ADMIN_COMPANY_CODE=
DEV_ADMIN_PASSWORD=
# 32 random bytes in base64. Keep outside the database; required to save/use DeepSeek keys.
# OpenAI/DeepSeek/Claude keys are configured per company/provider in the protected API and encrypted.
ASSISTANT_CREDENTIAL_KEY=
# Optional key rotation (preferred for non-local envs):
# JWT_SECRETS_JSON=[{"kid":"2026-q4","secret":"secret-v1"},{"kid":"2027-q1","secret":"secret-v2"}]
# JWT_ACTIVE_KID=2027-q1

# FRONTEND
FRONTEND_PORT=4200

# DATABASE
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=erp360
POSTGRES_USER=erp360
POSTGRES_PASSWORD=erp360_dev_password
